rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // Motor listings - Akses langsung tanpa login
    match /motors/{motorId} {
      allow read, write: if true;
    }

    // Customer database - Akses langsung tanpa login
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Sales Profile & Banner - Akses langsung tanpa login
    match /sales_profiles/{userId} {
      allow read, write: if true;
    }
  }
}
